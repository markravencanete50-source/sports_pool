# ─────────────────────────────────────────────────────────────
# SELF-HOSTED DOCKER STACK — environment template
#
# docker-compose.yml expects a file named `.env.docker` next to it. Copy this
# file to `.env.docker` and fill it in. NEVER commit the filled-in file.
#
# This is SEPARATE from `.env.example`: that one covers the Vercel-hosted app,
# this one additionally configures the self-hosted Supabase stack (Postgres,
# GoTrue auth, PostgREST, Realtime, Kong) and the Cloudflare tunnel.
#
# BUILD ORDER — the Dockerfile copies a PREBUILT `.next/standalone`; it does not
# run `next build` inside the image. So build on the host first:
#     npm ci && npm run build && docker compose build
#
# SCHEDULED JOBS — Vercel ran two of these from vercel.json; a VPS runs
# neither on its own. The compose stack now includes both as sidecar services:
#   * settle-cron     → /api/cron/settle     every 15 minutes (pays pools out)
#   * reconcile-cron  → /api/cron/reconcile  daily (Stripe<->ledger mismatches)
# Both need CRON_SECRET below — the endpoints fail closed (503) without it,
# so a missing secret means no settlement, not open settlement.
#
# The error-alert digest (/api/cron/alert) is still driven by GitHub Actions
# (.github/workflows/alert.yml). Point its APP_URL secret at this host's
# public URL and set the same CRON_SECRET as an Actions secret, or add a
# third sidecar in docker-compose.yml following the same pattern (if you do,
# disable the workflow so the same window is not paged twice).
# ─────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# Use a long random value.
POSTGRES_PASSWORD=

# ── Supabase keys ───────────────────────────────────────────
# JWT_SECRET must be at least 32 characters. ANON_KEY and SERVICE_ROLE_KEY are
# JWTs SIGNED WITH THAT SECRET — generate all three together, e.g. with
# https://supabase.com/docs/guides/self-hosting#api-keys
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
# Phoenix cookie signing salt for Realtime. Must be >= 64 characters.
SECRET_KEY_BASE=

# ── URLs ────────────────────────────────────────────────────
# Public origin of the app; used for auth redirects and email links.
SITE_URL=http://localhost:3000
# Public origin of the Supabase API gateway (Kong).
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=

# ── Auth (GoTrue) ───────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Leave autoconfirm FALSE in production so email ownership is actually verified.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
MAILER_URLPATHS_CONFIRMATION=/auth/callback
MAILER_URLPATHS_INVITE=/auth/callback
MAILER_URLPATHS_RECOVERY=/auth/callback
MAILER_URLPATHS_EMAIL_CHANGE=/auth/callback

# ── SMTP (auth emails: confirmation, recovery) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Gridiron
SMTP_ADMIN_EMAIL=

# ── PostgREST ───────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000

# ── Supabase Studio dashboard (basic auth via Kong) ─────────
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

# ── Cloudflare tunnel (optional public ingress) ─────────────
# From: Cloudflare Zero Trust > Networks > Tunnels. Leave blank to disable.
TUNNEL_TOKEN=

# ─────────────────────────────────────────────────────────────
# APPLICATION VARS
#
# The `nextjs` service loads THIS SAME FILE via env_file, so the app's own
# variables must also be set here. Mirror them from .env.example — at minimum:
#
#   NEXT_PUBLIC_SUPABASE_URL      (= API_EXTERNAL_URL)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY (= ANON_KEY)
#   SUPABASE_SERVICE_ROLE_KEY     (= SERVICE_ROLE_KEY)
#   NEXT_PUBLIC_APP_URL           (= SITE_URL)
#   STRIPE_SECRET_KEY / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY / STRIPE_WEBHOOK_SECRET
#   PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET / PAYPAL_MODE
#   CRON_SECRET   (required, or /api/cron/settle fails closed with 503)
#   SETUP_SECRET  (one-time admin bootstrap; unset it again afterwards)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

CRON_SECRET=
SETUP_SECRET=

# One-time admin bootstrap (see docs/RUNBOOK.md §5). The account this address
# belongs to must SIGN UP through /signup first; then POST /api/seed-admin
# with "Authorization: Bearer $SETUP_SECRET" promotes it. Unset SETUP_SECRET
# and restart once done.
ADMIN_USER_EMAIL=

# TEST WINDOW ONLY. A self-hosted production build (NODE_ENV=production) has
# no preview tier, so sandbox payouts are refused unless this is explicitly
# "true". Remove it before taking real money — /api/health reports sandbox
# mode on production as degraded either way.
ALLOW_SANDBOX_PAYOUTS=

# Where the error digest posts (Slack/Discord/Mattermost-style webhook).
# Without it the digest is written to logs only.
ALERT_WEBHOOK_URL=

# Edge-layer jurisdiction blocklist, e.g. "US-WA,US-NV" — a cache of
# jurisdiction_rules for the proxy layer; the money boundary enforces the
# database rules regardless. Leave unset until the client's jurisdiction
# list is agreed.
COMPLIANCE_BLOCKED_REGIONS=

NEXT_PUBLIC_POOL_MIN_GAMES=6
NEXT_PUBLIC_POOL_MAX_GAMES=9

# This stack terminates traffic at the cloudflared tunnel, so cf-connecting-ip
# and cf-ipcountry are set by Cloudflare and are the real client IP/location.
# Declaring that here lets the rate limiter key on the IP AND lets the
# compliance gate trust the geolocation — without it every request resolves to
# "location unknown", which the money boundary refuses in production (nobody
# can buy a card). Leave it unset if you remove the tunnel — an unverified
# platform header is client-forgeable and would defeat both controls. For
# region-level rules (e.g. blocking US-WA), also enable Cloudflare's
# "Add visitor location headers" managed transform so cf-region-code arrives.
TRUSTED_PROXY=cloudflare

# Optional
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
