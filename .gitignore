# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER COMMIT
.env
.env.*
!.env.example
# Template only — placeholders, no real values. Must be committed or the
# documented self-hosted Docker path cannot be reproduced from a clone.
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Docker self-hosted
.env.docker
volumes/db/
volumes/storage/
supabase/dumps/
.next/
supabase/.temp/

.vercel

# Single lockfile policy: this project standardises on npm (package-lock.json).
# CI runs `npm ci`. Do not commit a second lockfile — two lockfiles resolve to
# two different dependency trees depending on who installed last.
bun.lock

# Generated from the .docx by Word; regenerate locally rather than version them.
*.pdf

# Playwright
test-results/
playwright-report/
