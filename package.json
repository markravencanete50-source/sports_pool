{
  "name": "gridiron",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "db:migrate": "supabase db push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "seed": "tsx scripts/seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run verify:settlement",
    "verify:settlement": "tsx scripts/verify-settlement.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:crons": "tsx scripts/check-vercel-crons.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "check": "npm run typecheck && npm run check:migrations && npm run check:crons && npm run check:docs && npm run test && npm run lint",
    "docs:generate": "node scripts/gen-handover-doc.cjs && node scripts/gen-security-report.cjs && node scripts/gen-backend-explainer.cjs && node scripts/gen-backend-technical.cjs && node scripts/gen-fullstack-audit.cjs && node scripts/gen-combined-doc.cjs && node scripts/gen-client-brief.cjs && node scripts/gen-transfer-guide.cjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "docs:combined": "node scripts/gen-combined-doc.cjs",
    "check:docs": "tsx scripts/check-docs.ts",
    "test:browser": "playwright test",
    "docs:brief": "node scripts/gen-client-brief.cjs",
    "docs:transfer": "node scripts/gen-transfer-guide.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
