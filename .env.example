# ─────────────────────────────────────────────────────────────
# SportsPool — environment template
# Copy to .env.local and fill in. NEVER commit the filled-in file.
# Real values live in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses ALL row-level security. Server-side only.
# Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bootstraps the first admin account (scripts/seed-admin.ts)
ADMIN_USER_EMAIL=admin@example.com

# ── Stripe (entry fees / card purchase) ─────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Required by the /api/stripe/webhook endpoint (see handoff PDF §1.1).
# Without a verified webhook a user can be charged with no card issued.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── PayPal (withdrawals / payouts) ──────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ── Scheduled jobs (handoff PDF §1.2) ───────────────────────
# Shared secret for scheduled invocation of /api/sync/nfl-games and
# /api/pools/complete-finished. Vercel Cron sends this as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# Gates /api/seed-admin, the one-time admin bootstrap. That endpoint performs a
# SERVICE-ROLE write, so it fails closed (503) when this is unset. Unset it again
# once the admin account exists.
SETUP_SECRET=generate-a-different-long-random-string

# ── NFL data ────────────────────────────────────────────────
# Live (default):
NFL_SCOREBOARD_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl
# Mock mode: point at your own app so /scoreboard is served by /api/nfl/scoreboard
# NFL_SCOREBOARD_BASE_URL=http://localhost:3000/api/nfl

# ── Pool rules ──────────────────────────────────────────────
NEXT_PUBLIC_POOL_MIN_GAMES=6
NEXT_PUBLIC_POOL_MAX_GAMES=9

# ── Chat moderation (optional) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
