# ─────────────────────────────────────────────────────────────
# SportsPool — environment template
# Copy to .env.local and fill in. NEVER commit the filled-in file.
# Real values live in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses ALL row-level security. Server-side only.
# Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bootstraps the first admin account (scripts/seed-admin.ts)
ADMIN_USER_EMAIL=admin@example.com

# ── Stripe (entry fees / card purchase) ─────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Required by the /api/stripe/webhook endpoint (see handoff PDF §1.1).
# Without a verified webhook a user can be charged with no card issued.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── PayPal (withdrawals / payouts) ──────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ── Scheduled jobs (handoff PDF §1.2) ───────────────────────
# Shared secret for scheduled invocation of /api/sync/nfl-games and
# /api/pools/complete-finished. Vercel Cron sends this as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# Gates /api/seed-admin, the one-time admin bootstrap. That endpoint performs a
# SERVICE-ROLE write, so it fails closed (503) when this is unset. Unset it again
# once the admin account exists.
SETUP_SECRET=generate-a-different-long-random-string

# ── NFL data ────────────────────────────────────────────────
# Live (default):
NFL_SCOREBOARD_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl
# Mock mode: point at your own app so /scoreboard is served by /api/nfl/scoreboard
# NFL_SCOREBOARD_BASE_URL=http://localhost:3000/api/nfl

# ── Pool rules ──────────────────────────────────────────────
NEXT_PUBLIC_POOL_MIN_GAMES=6
NEXT_PUBLIC_POOL_MAX_GAMES=9

# ── Chat moderation (optional) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ── Rate limiting (optional but recommended in production) ───
# Shared-store backend for src/lib/rate-limit.ts. When BOTH are set, auth and
# money endpoints are throttled GLOBALLY across all serverless instances via
# Upstash Redis (HTTP REST — no persistent connection, ideal for Vercel).
# When unset, the limiter degrades to a per-instance in-memory window
# (best-effort).
#
# Two ways to provision, EITHER works — the code reads both name sets:
#   1. By hand: create a DB at https://console.upstash.com → Redis, and set the
#      two UPSTASH_ names below.
#   2. Vercel's Upstash marketplace integration (Storage → Create Database),
#      which auto-injects KV_REST_API_URL and KV_REST_API_TOKEN. Nothing to set
#      here in that case — do NOT also set the UPSTASH_ names to different values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Which edge (if any) sits in front of this app, for rate-limit client-IP
# resolution. Platform headers like cf-connecting-ip are only trustworthy when
# the request actually transited that edge — otherwise a caller forges one per
# request and gets a private bucket, defeating every throttle.
#
# On Vercel, leave this UNSET: the VERCEL env var is detected automatically.
# Set to `cloudflare` ONLY when the app is genuinely behind Cloudflare (e.g. the
# self-hosted docker-compose stack with the cloudflared tunnel).
# Any other value means "trust no platform header" and fall back to the
# rightmost X-Forwarded-For hop.
TRUSTED_PROXY=
